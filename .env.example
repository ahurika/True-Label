# ============================================================
# TrueLabel Environment Configuration Template
# Copy this file to .env and supply your credentials
# ============================================================

# Database (Neon Serverless PostgreSQL)
# 1. Sign up at https://neon.tech
# 2. Create a project named 'truelabel'
# 3. Copy the pooled connection string into DATABASE_URL
# 4. Copy the direct (unpooled) connection string into DIRECT_URL
DATABASE_URL="postgresql://<user>:<password>@<endpoint>-pooler.<region>.aws.neon.tech/<dbname>?sslmode=require"
DIRECT_URL="postgresql://<user>:<password>@<endpoint>.<region>.aws.neon.tech/<dbname>?sslmode=require"

# Ephemeral Cache & Rate Limiting (Upstash Redis)
# 1. Sign up at https://upstash.com
# 2. Create a Serverless Redis database named 'truelabel-cache'
# 3. Copy the REST URL and REST Token below
UPSTASH_REDIS_REST_URL="https://<endpoint>.upstash.io"
UPSTASH_REDIS_REST_TOKEN="<token>"

# Application Canonical URL & SEO Base
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Environment & Runtime
NODE_ENV="development"
PORT=3000

# WhatsApp Cloud API Webhook Verification
WHATSAPP_WEBHOOK_VERIFY_TOKEN="<token>"
WHATSAPP_SERVER_SECRET="<secret>"

# Daily AI Extraction Spend Cap
DAILY_AI_SPEND_CAP_USD=50.00

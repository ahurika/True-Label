# ============================================================
# TrueLabel Environment Configuration Template
# Copy this file to .env and supply your credentials
# ============================================================

# ------------------------------------------------------------
# 1. AI Vision & Multimodal Packaging OCR (CRITICAL FOR SCANNING)
# ------------------------------------------------------------
# TrueLabel uses Google Gemini 1.5 Flash to inspect packaging photos,
# read printed text, and extract brand, product name, NAFDAC number,
# manufacturer, batch, expiry, and medicine directions into structured JSON.
# Get a free API key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY="your_gemini_api_key_here"

# ------------------------------------------------------------
# 2. Database (Neon Serverless PostgreSQL)
# ------------------------------------------------------------
# TrueLabel stores curated NAFDAC registry records, public recall alerts,
# and audit logs in PostgreSQL.
# 1. Sign up at https://neon.tech
# 2. Create a project named 'truelabel'
# 3. DATABASE_URL: Pooled connection string (with -pooler) for runtime queries
# 4. DIRECT_URL: Direct unpooled connection string for Prisma migrations
DATABASE_URL="postgresql://<user>:<password>@<endpoint>-pooler.<region>.aws.neon.tech/<dbname>?sslmode=require"
DIRECT_URL="postgresql://<user>:<password>@<endpoint>.<region>.aws.neon.tech/<dbname>?sslmode=require"

# ------------------------------------------------------------
# 3. Ephemeral Cache & Distributed Rate Limiting (Upstash Redis)
# ------------------------------------------------------------
# Upstash Redis handles sliding-window rate limiting and ephemeral 30-minute
# intermediate scan sessions (PRD v4.0 §11.3).
# 1. Sign up at https://upstash.com
# 2. Create a Serverless Redis database named 'truelabel-cache'
# 3. Copy the REST URL and REST Token below
UPSTASH_REDIS_REST_URL="https://<endpoint>.upstash.io"
UPSTASH_REDIS_REST_TOKEN="<token>"

# ------------------------------------------------------------
# 4. Application Canonical URL & SEO
# ------------------------------------------------------------
# Base URL used for OpenGraph cards and 30-day read-only result share links.
# For local machine testing: http://localhost:3000
# For testing from phone on same Wi-Fi: http://<YOUR_COMPUTER_IP>:3000 (e.g. http://192.168.1.50:3000)
# For production: https://truelabel.ng
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ------------------------------------------------------------
# 5. Environment & Runtime
# ------------------------------------------------------------
NODE_ENV="development"
PORT=3000

# ------------------------------------------------------------
# 6. Safety & AI Spend Guardrails (PRD v4.0 §11)
# ------------------------------------------------------------
# Daily spend ceiling in USD for AI extraction before circuit breaker trips
DAILY_AI_SPEND_CAP_USD=50.00

# ------------------------------------------------------------
# 7. WhatsApp Cloud API Webhook (Optional / Phase 2)
# ------------------------------------------------------------
# Only required if deploying the WhatsApp bot gateway
WHATSAPP_WEBHOOK_VERIFY_TOKEN="your_verify_token_here"
WHATSAPP_SERVER_SECRET="your_hmac_sha256_server_secret_here"
